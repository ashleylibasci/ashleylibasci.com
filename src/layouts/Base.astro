---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import { SITE_NAME } from '../lib/nav';
import { CONTACTS } from '../lib/contacts';
import { CANONICAL_ORIGIN, canonicalUrl } from '../lib/canonical';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageFocus from '../islands/page-focus/PageFocus.astro';
import SecretCode from '../islands/secret-code/SecretCode.astro';
import ConsoleHello from '../islands/console-hello/ConsoleHello.astro';

interface Props {
  /** Page name; the home page leaves it out and gets the bare site name. */
  title?: string;
  /** NAV key of the current page, for aria-current. */
  section?: string;
}

const { title, section } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = canonicalUrl(Astro.url.pathname);
// The inline head script below sets the theme before first paint (AD-7):
// light unless the stored choice is dark. It is the only initial writer.

// The Cloudflare Web Analytics beacon (AD-11) is the only third-party request: cookieless,
// page views only. Its token is public by design; it is not a secret.
const ANALYTICS_TOKEN = '1265ff617cb540e59b9de2a126db2a2c';
// Link previews: every page shares the one social card (public/social-card.png, 1200x630,
// the name card Ashley chose) and the one site description.
const DESCRIPTION =
  'Ashley Libasci studies math and computer science at UIUC and is looking for a software engineering, cybersecurity or quant internship for summer 2027.';
const SOCIAL_CARD = new URL('/social-card.png', CANONICAL_ORIGIN).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          if (localStorage.getItem('al-theme') === 'dark') theme = 'dark';
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <title>{fullTitle}</title>
    <Font cssVariable="--font-marcellus" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-albert-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={DESCRIPTION} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={SOCIAL_CARD} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ashley Libasci. Math and computer science at UIUC. ashleylibasci.com" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[{ 'on-home': section === 'home' }]}>
    <a class="skip" href="#page-heading">Skip to content</a>
    <Header section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PageFocus />
    <SecretCode />
    <ConsoleHello href={CONTACTS.github} />
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}></script>
  </body>
</html>
