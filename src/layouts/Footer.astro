---
import { COPYRIGHT_YEAR, UPDATED_LABEL } from '../lib/build-time';
import FooterDog from '../islands/footer-dog/FooterDog.astro';
import RomanYear from '../islands/roman-year/RomanYear.astro';
import { SITE_NAME } from '../lib/nav';
---
<footer class="foot">
  <div class="wrap" data-dog-row>
    <span class="cr"><span>© <RomanYear year={COPYRIGHT_YEAR} /> {SITE_NAME}</span><span data-slot="footer-drawing"><FooterDog /></span></span>
    <span>Updated {UPDATED_LABEL}</span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--color-line);
  }

  .foot .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    font: var(--type-meta);
    color: var(--color-ink-3);
  }

  .cr {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    /* With the drawing in, a one-line footer is 82px: the room the lost page keeps for it. */
    min-height: 33px;
  }

  .cr > span {
    padding-bottom: 1px;
  }

  /* The drawing sits on the same line as the text, with no line box of its own. */
  .cr > [data-slot] {
    display: flex;
  }
</style>
