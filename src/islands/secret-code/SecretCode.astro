---
// The secret code (AD-5 island): thin outline bubbles rise up the whole window.
// The layer is markup the island owns; only its script writes the bubbles in it.
---
<div class="code-rise" data-secret-code aria-hidden="true"></div>

<script>
  import './secret-code.ts';
</script>

<style>
  /* Above the header (30), below the menu sheet (70) and the skip link (80). */
  .code-rise {
    position: fixed;
    inset: 0;
    z-index: 58;
    pointer-events: none;
    overflow: hidden;
  }

  .code-rise :global(i) {
    position: absolute;
    bottom: -24px;
    display: block;
    border: 1px solid var(--color-egg-teal);
    border-radius: 50%;
    opacity: 0;
    animation: code-rise var(--d, 3s) cubic-bezier(0.3, 0.1, 0.5, 1) var(--w, 0s) forwards;
  }

  /* Reduced motion: the global rule drops the animation, so still bubbles set their own look. */
  .code-rise.still :global(i) {
    bottom: auto;
    animation: none;
    opacity: 0.5;
  }

  @keyframes code-rise {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    10% {
      opacity: 0.75;
    }
    80% {
      opacity: 0.6;
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx, 0px), calc(-100vh - 48px));
    }
  }
</style>
