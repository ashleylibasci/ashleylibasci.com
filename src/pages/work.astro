---
// Work: one entry per project of the projects collection, in `order`, then the note on a
// smaller project. Every word of an entry comes from the collection; the schema carries no
// image fields, so each entry's pictures and their alt text are mapped here by entry id.
import type { ComponentProps } from 'astro/types';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import WorkEntry from '../components/WorkEntry.astro';
import WorkVisual from '../components/WorkVisual.astro';
import { fillTemplate, templateParts } from '../lib/format';
import { navItem } from '../lib/nav';
import healthIcon from '../assets/healthdash-icon.png';
import healthSleep from '../assets/healthdash-sleep.jpg';
import healthFitness from '../assets/healthdash-fitness.jpg';
import careerOg from '../assets/careerstar-og.png';
import proofOfHistory from '../assets/proof-of-history.png';

type Visual = ComponentProps<typeof WorkVisual>;
// A visual without its link: what the map below gives for an entry.
type Without<T, K extends PropertyKey> = T extends unknown ? Omit<T, K> : never;
type Picture = Without<Visual, 'href' | 'label'>;

const PICTURES: Record<string, Picture> = {
  'health-dashboard': {
    kind: 'app',
    icon: { image: healthIcon, alt: 'Health Dashboard app icon: a sunburst with a heartbeat line' },
    screens: [
      { image: healthSleep, alt: 'Sleep tab on iPhone, showing example data' },
      { image: healthFitness, alt: 'Fitness tab on iPhone, showing example data' },
    ],
  },
  'career-star': {
    kind: 'plate',
    image: careerOg,
    alt: 'Career Star case study. Social card: Rate careers like stocks, with a sample rating for registered nurses.',
  },
  research: {
    kind: 'plate',
    image: proofOfHistory,
    alt: 'About the research. The Proof of History home page, a work in progress: How Mathematicians Shared and Tested Their Work.',
    zoom: 1.171,
    position: '50% 100%',
  },
};

const LIVE_LABEL = 'Open the live app';

const page = navItem('work');
const home = navItem('home');

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const entries = projects.map(({ id, data }) => {
  const plate = data.work.plate;
  const picture: Picture | undefined =
    PICTURES[id] ?? (plate && { kind: 'typeset', source: fillTemplate(plate.source, data), text: plate.text });
  if (!picture) {
    throw new Error(`work: the project entry "${id}" has neither a picture nor a work.plate`);
  }
  const href = data.href;
  return {
    title: data.title,
    href,
    tag: templateParts(data.work.tag, data),
    status: data.status,
    summary: data.summary,
    links: [
      { href, label: data.work.linkLabel },
      ...(data.liveUrl ? [{ href: data.liveUrl, label: LIVE_LABEL }] : []),
    ],
    visual: { ...picture, href, label: data.work.visualLabel },
  };
});

// The smaller project is a timeline entry; its sentence fills from that entry's own dates.
const notes = (await getCollection('timeline')).flatMap(({ data }) =>
  data.workNote ? [fillTemplate(data.workNote, data)] : [],
);
---
<Base title={page.label} section={page.key}>
  <PageHead
    title={page.label}
    standfirst="What I'm building right now, and what I built before it."
    crumbs={[{ label: home.label, href: home.href }]}
  />
  <div class="wrap art">
    {
      entries.map((entry) => (
        <WorkEntry
          title={entry.title}
          href={entry.href}
          tag={entry.tag}
          status={entry.status}
          summary={entry.summary}
          links={entry.links}
        >
          <WorkVisual {...entry.visual} />
        </WorkEntry>
      ))
    }
    {notes.map((note) => <p class="small-p"><b>A smaller project:</b> {note}</p>)}
  </div>
</Base>

<style>
  .small-p {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-2);
    max-width: 46em;
  }

  .small-p b {
    font-weight: 500;
    color: var(--color-ink);
  }
</style>
