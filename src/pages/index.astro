---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PrintFrame from '../components/PrintFrame.astro';
import FramedImage from '../components/FramedImage.astro';
import CopyEmail from '../islands/copy-email/CopyEmail.astro';
import HealthDemo from '../islands/health-demo/HealthDemo.astro';
import { CONTACTS } from '../lib/contacts';
import { routeExists } from '../lib/routes';
import headshot from '../assets/headshot-full.jpg';
import healthIcon from '../assets/healthdash-icon.png';

const RESUME_HREF = '/about#resume';
const showResume = routeExists(RESUME_HREF);

// The print's title and link target are facts of the project; the link waits for its page.
const health = await getEntry('projects', 'health-dashboard');
if (!health) throw new Error('index: the health-dashboard project entry is missing');
const healthHref = routeExists(health.data.href) ? health.data.href : null;
---
<Base section="home">
  <div class="first wrap">
    <section class="hero g12" aria-labelledby="page-heading">
      <div class="me">
        <div class="id">
          <h1 id="page-heading" tabindex="-1">Ashley Libasci</h1>
          <PrintFrame class="pic">
            <FramedImage
              src={headshot}
              alt="Ashley Libasci"
              widths={[130, 160, 216, 260, 320, 432, 480, 648]}
              sizes="(max-width: 760px) clamp(130px, 40vw, 160px), clamp(190px, 15vw, 216px)"
              position="48% 30%"
              eager
            />
          </PrintFrame>
          <p class="intro">I study math and computer science at the University of Illinois Urbana-Champaign, with a statistics minor, class of 2028. I like problems where you can check the answer, and I like shipping the thing once it works.</p>
        </div>
        <p class="seek">I'm looking for a software engineering, cybersecurity or quant internship for summer&nbsp;2027.</p>
        <div class="acts">
          {showResume && <a class="btn" href={RESUME_HREF}>Resume</a>}
          <CopyEmail email={CONTACTS.email} />
          <span class="soc"><a href={CONTACTS.github}>GitHub</a><a href={CONTACTS.linkedin}>LinkedIn</a></span>
        </div>
      </div>

      <div class="nowx">
        <PrintFrame>
          <section class="now" aria-labelledby="h-now">
            <div class="now-head">
              <FramedImage src={healthIcon} alt="" widths={[48, 96, 144]} sizes="48px" class="now-icon" />
              <div>
                <p class="now-k">What I'm building now</p>
                <h2 id="h-now">{healthHref ? <a href={healthHref}>{health.data.title}</a> : health.data.title}</h2>
              </div>
            </div>
            <p class="now-d">A sleep and recovery app for iPhone and Apple Watch, written in Swift. The data stays on the device.</p>
            <HealthDemo />
          </section>
        </PrintFrame>
        <p class="placard">
          <span class="pl-t">A working preview</span>
          <span class="pl-m">2026 · Swift · iPhone and Apple Watch</span>
          <span class="pl-d">Getting ready for TestFlight.{healthHref && <>{' '}<a href={healthHref}>How I'm building it</a></>}</span>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  /* The first screen is one page: header plus hero fill the viewport, the content centered inside it. */
  .first {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - var(--nav) - 1px);
    min-height: calc(100svh - var(--nav) - 1px);
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .hero {
    align-items: center;
  }

  .me {
    grid-column: 1 / 8;
    padding-right: var(--space-7);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* The photo on the left, the name centered on the photo's middle with the intro under it. */
  .id {
    --pw: clamp(190px, 15vw, 216px);
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    grid-template-areas:
      'pic .'
      'pic name'
      'pic intro'
      'pic .';
    grid-template-rows: 1fr auto auto 1fr;
    column-gap: calc(var(--space-5) + var(--space-3));
    align-items: start;
  }

  .pic {
    grid-area: pic;
  }

  /* The name always stays on one line. */
  h1 {
    grid-area: name;
    color: var(--color-ink);
    font: var(--type-name);
    letter-spacing: var(--type-name-tracking);
    white-space: nowrap;
    margin: -5px 0 var(--space-4);
  }

  .intro {
    grid-area: intro;
    font: var(--type-intro);
    color: var(--color-ink-2);
    max-width: 31em;
    text-wrap: pretty;
  }

  .seek {
    font: var(--type-seek);
    font-variant-numeric: lining-nums;
    color: var(--color-ink);
    margin-top: var(--space-6);
    max-width: 26em;
    text-wrap: balance;
  }

  /* The Health Dashboard print hangs in columns 8 to 12, its Placard under it. */
  .nowx {
    grid-column: 8 / 13;
    min-width: 0;
  }

  .now {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-field);
    color: var(--color-ink);
    border-radius: var(--radius-hairline);
    padding: 26px var(--space-5) 22px;
  }

  .now-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .now-head .now-icon {
    --pw: 48px;
    flex: none;
    border-radius: var(--radius-sm);
  }

  .now-k {
    font: var(--type-meta);
    letter-spacing: 0.01em;
    color: var(--color-teal-text);
  }

  .now h2 {
    font: var(--type-panel-title);
    font-variant-numeric: lining-nums;
    margin-top: 2px;
  }

  .now h2 a {
    color: var(--color-ink);
    text-decoration-color: transparent;
    text-underline-offset: 5px;
  }

  .now h2 a:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-aqua);
  }

  .now-d {
    margin-top: var(--space-3);
    font: var(--type-ui);
    color: var(--color-ink-2);
  }

  .placard {
    margin-top: 14px;
  }

  .pl-t {
    display: block;
    font: var(--type-print-title);
    font-variant-numeric: lining-nums;
    color: var(--color-ink);
  }

  .pl-m {
    display: block;
    margin-top: 3px;
    font: var(--type-caption);
    color: var(--color-ink-3);
  }

  .pl-d {
    display: block;
    margin-top: 5px;
    font: var(--type-label);
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .pl-d a {
    white-space: nowrap;
  }

  .acts {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) 28px;
  }

  .soc {
    display: flex;
    gap: var(--space-5);
    white-space: nowrap;
  }

  .soc a {
    font: var(--type-ui);
  }

  .btn {
    display: inline-block;
    background: var(--color-cta);
    color: var(--color-cta-ink);
    font: var(--type-button);
    letter-spacing: var(--type-button-tracking);
    text-decoration: none;
    padding: 13px 26px;
    border-radius: var(--radius-full);
    transition: background-color var(--t) ease-out;
  }

  .btn:hover {
    background: var(--color-cta-hover);
    color: var(--color-cta-ink);
  }

  /* Short laptop screens: keep the whole first screen above the fold. */
  @media (min-width: 1061px) and (max-height: 860px) {
    .first {
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }

    .seek {
      margin-top: var(--space-5);
    }
  }

  @media (max-width: 1060px) {
    .first {
      min-height: 0;
      padding-top: var(--space-7);
      padding-bottom: var(--space-8);
    }

    .me {
      grid-column: 1 / -1;
      padding-right: 0;
    }

    .nowx {
      grid-column: 1 / -1;
      margin-top: var(--space-7);
    }

    h1 {
      font: var(--type-name-tablet);
      letter-spacing: var(--type-name-tablet-tracking);
    }
  }

  @media (max-width: 760px) {
    .first {
      padding-top: var(--space-6);
      padding-bottom: var(--space-7);
    }

    /* Phones: one column, the photo above the name, still on the left; the intro runs full width. */
    .id {
      --pw: clamp(130px, 40vw, 160px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'pic'
        'name'
        'intro';
      grid-template-rows: auto auto auto;
    }

    .pic {
      justify-self: start;
      margin-bottom: var(--space-5);
    }

    h1 {
      font: var(--type-name-mobile);
      letter-spacing: var(--type-name-mobile-tracking);
      margin: 0;
    }

    .intro {
      margin-top: var(--space-5);
    }

    .seek {
      font: var(--type-seek-mobile);
      font-variant-numeric: lining-nums;
      margin-top: var(--space-5);
    }

    .acts {
      gap: var(--space-3) var(--space-5);
    }

    .now {
      padding: var(--space-5) 20px 18px;
    }

    .now h2 {
      font-size: 29px;
    }

    .soc a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
