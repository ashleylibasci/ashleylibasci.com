---
// About: the greeting beside the smaller framed headshot, then Now, Education, Skills,
// Contact and Resume. Education comes from the experience collection, Skills from the
// skills collection and the addresses from CONTACTS. The Resume section lives at
// /about#resume and holds the Placeholder until the PDF is supplied.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleSection from '../components/ArticleSection.astro';
import FramedImage from '../components/FramedImage.astro';
import PageHead from '../components/PageHead.astro';
import Placeholder from '../components/Placeholder.astro';
import PrintFrame from '../components/PrintFrame.astro';
import { CONTACTS } from '../lib/contacts';
import { formatRange } from '../lib/format';
import { navItem } from '../lib/nav';
import headshot from '../assets/headshot-full.jpg';

const page = navItem('about');
const home = navItem('home');
const experience = navItem('experience');
const resume = navItem('resume');
// The Resume item must point at a section of this page.
const [resumePath, resumeAnchor] = resume.href.split('#');
if (resumePath !== page.href || !resumeAnchor) throw new Error(`about: the Resume item "${resume.href}" is not a section of ${page.href}`);

const schools = (await getCollection('experience')).flatMap(({ data }) => (data.kind === 'education' ? [data] : []));
if (schools.length !== 1) throw new Error(`about: expected one education entry, found ${schools.length}`);
const [school] = schools;

const skills = (await getCollection('skills')).map(({ data }) => data).sort((a, b) => a.order - b.order);
if (skills.length === 0) throw new Error('about: the skills collection is empty');

// An address as it is shown: without the scheme and "www.".
const shown = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---
<Base title={page.label} section={page.key}>
  <PageHead
    title="Hi, I'm Ashley."
    current={page.label}
    standfirst="I like problems where the answer can be checked, like a model tested against ten years of labor data or a proof Lean verifies line by line."
    crumbs={[{ label: home.label, href: home.href }]}
  >
    <Fragment slot="photo">
      <PrintFrame class="pic">
        <FramedImage
          src={headshot}
          alt="Ashley Libasci"
          widths={[116, 148, 166, 232, 296, 332, 348, 444, 498]}
          sizes="(max-width: 760px) 116px, clamp(148px, 11.4vw, 166px)"
          position="48% 30%"
        />
      </PrintFrame>
    </Fragment>
  </PageHead>
  <div class="wrap art">
    <ArticleSection id="now" heading="Now">
      <p>This fall I'm researching machine-written proofs at the Illinois Mathematics Lab and building the Health Dashboard, a sleep and recovery app for iPhone and Apple Watch, on its way to TestFlight. This summer I was a cybersecurity intern at Baxter Credit Union and built Career Star. I'm looking for 2027 internships in software engineering, cybersecurity and quant.</p>
    </ArticleSection>
    <ArticleSection id="education" heading="Education">
      <dl class="facts">
        <dt>School</dt><dd>{school.school}</dd>
        <dt>Degree</dt><dd>{school.degree}</dd>
        <dt>Minor</dt><dd>{school.minor}</dd>
        <dt>Dates</dt><dd>{formatRange(school.start, school.end)}</dd>
        <dt>Coursework</dt><dd>Listed on my <a href={experience.href}>{experience.label}</a> page</dd>
      </dl>
    </ArticleSection>
    <ArticleSection id="skills" heading="Skills">
      <dl class="facts">
        {skills.map((group) => (<Fragment><dt>{group.label}</dt><dd>{group.items.join(', ')}</dd></Fragment>))}
      </dl>
    </ArticleSection>
    <ArticleSection id="contact" heading="Contact">
      <dl class="facts">
        <dt>Email</dt><dd><a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a></dd>
        <dt>LinkedIn</dt><dd><a href={CONTACTS.linkedin}>{shown(CONTACTS.linkedin)}</a></dd>
        <dt>GitHub</dt><dd><a href={CONTACTS.github}>{shown(CONTACTS.github)}</a></dd>
      </dl>
    </ArticleSection>
    <ArticleSection id="resume-heading" heading={resume.label} anchor={resumeAnchor}>
      <p>One page, updated November 2026.</p>
      <Placeholder>The resume PDF and its download link go here.</Placeholder>
    </ArticleSection>
  </div>
</Base>

<style>
  /* The smaller framed headshot. */
  .pic {
    --pw: clamp(148px, 11.4vw, 166px);
    flex: none;
  }

  @media (max-width: 760px) {
    .pic {
      --pw: 116px;
    }

    /* 44px touch targets; inline padding moves no line. */
    .art dl.facts a {
      padding: 13px 0;
    }
  }
</style>
