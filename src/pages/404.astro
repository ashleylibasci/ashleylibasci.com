---
// Lost page: what an unknown address gets. Built to dist/404.html for the host's
// not-found rule. The two lines are the approved copy; the title is the skip-link
// and page-load focus target. No nav tab is current here. Beside the title, a small
// swimmer holds a sheet and lets three bubbles go; it bobs gently when motion is
// allowed. A static picture with no script: nothing in it is focusable or read out.
import Base from '../layouts/Base.astro';
import Swimmer from '../components/drawings/Swimmer.astro';
import { navItem } from '../lib/nav';

const home = navItem('home');
---
<Base title="Not found">
  <div class="wrap lost">
    <div class="lost-in">
      <span class="lost-s" aria-hidden="true"><Swimmer viewBox="-3 -6 27 52">
        <circle class="bubble" cx="5.4" cy="2.4" r=".9" />
        <circle class="bubble" cx="3.8" cy="-1.4" r="1.3" />
        <circle class="bubble" cx="5.6" cy="-4.6" r=".75" />
        <path class="sheet" d="M-.6 15.4 1.6 16.3 3.8 15.4 6 16.3V21.1L3.8 20.2 1.6 21.1-.6 20.2Z" />
        <path class="sheet-fold" d="M1.6 16.3V21.1M3.8 15.4V20.2" />
        <path class="sheet-line" d="M.2 19.2 1.6 18 3 18.8 4.9 17.5" />
      </Swimmer></span>
      <div class="text">
        <h1 id="page-heading" tabindex="-1">This page swam off.</h1>
        <p class="standfirst">It isn't here, but everything else is.</p>
        <p class="links"><a href={home.href}>Back to the home page</a></p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Centered in the space the bar and the footer leave. */
  .lost {
    /* Room for the footer, as the design gives it; a little over its one-line height. */
    --foot: 82px;
    min-height: calc(100vh - var(--nav) - var(--foot));
    min-height: calc(100svh - var(--nav) - var(--foot));
    display: flex;
    align-items: center;
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  /* A row, so a drawing can sit beside the text. */
  .lost-in {
    display: flex;
    align-items: center;
    gap: 44px;
  }

  .text {
    min-width: 0;
  }

  /* The swimmer: its box, a slight tilt on the drawing, the bob on the wrapper so the
     two never fight over one transform. */
  .lost-s {
    flex: none;
    display: block;
    width: 36px;
    height: 69px;
    opacity: 0.85;
  }

  .lost-s :global(svg) {
    width: 36px;
    height: 69px;
    transform: rotate(-14deg);
  }

  /* The slot content takes this page's scope, so its paint lives here. */
  .sheet {
    fill: var(--color-egg-fill);
    stroke: var(--color-egg-line);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .sheet-fold {
    fill: none;
    stroke: var(--color-egg-line);
    stroke-width: 0.45;
  }

  .sheet-line {
    fill: none;
    stroke: var(--color-egg-teal);
    stroke-width: 0.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bubble {
    fill: none;
    stroke: var(--color-egg-teal);
    stroke-width: 0.6;
  }

  /* The bob runs only when motion is allowed; otherwise the figure holds still. */
  @media (prefers-reduced-motion: no-preference) {
    .lost-s {
      animation: lost-bob 3.4s ease-in-out infinite alternate;
    }
  }

  @keyframes lost-bob {
    from {
      transform: translateY(-3px);
    }

    to {
      transform: translateY(3px);
    }
  }

  h1 {
    font: var(--type-page-title);
    font-size: clamp(40px, 4.3vw, 60px);
  }

  .standfirst {
    margin-top: var(--space-4);
    font: var(--type-standfirst);
    max-width: 38em;
    color: var(--color-ink-2);
  }

  .links {
    margin-top: var(--space-5);
    font: var(--type-ui);
  }

  @media (max-width: 760px) {
    .lost-in {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    /* A 44px touch area for the one link; inline padding moves no line. */
    .links a {
      padding: 13px 0;
    }
  }
</style>
