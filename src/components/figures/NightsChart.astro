---
// Figure 1 of the Health Dashboard case study: 28 sample nights, sleep as bars and heart-rate
// variability as a line. Drawn here at build time from the seeded generator, so it is the
// same on every load and needs no script. The label's ranges are read from the values.
// Goes inside Figure, which styles the classes.
import { EXAM_WEEK, sampleNights } from '../../lib/sample-nights';

const nights = sampleNights();
const sleep = nights.map((night) => night.sleep);
const hrv = nights.map((night) => night.hrv);

// The plot area inside the 960 x 250 drawing, and the two scales.
const LEFT = 60;
const RIGHT = 900;
const TOP = 20;
const BOTTOM = 200;
const SLEEP_AXIS = { min: 4, max: 10, ticks: [4, 6, 8, 10] };
const HRV_AXIS = { min: 30, max: 80, ticks: [30, 55, 80] };
const NIGHT_TICKS = [1, 7, 14, 21, 28];
const BAR_GAP = 3;

const step = (RIGHT - LEFT) / nights.length;
const n = (value: number) => String(Math.round(value * 10) / 10);
const scale = (axis: { min: number; max: number }) => (value: number) =>
  BOTTOM - ((value - axis.min) / (axis.max - axis.min)) * (BOTTOM - TOP);
const sleepY = scale(SLEEP_AXIS);
const hrvY = scale(HRV_AXIS);
const middle = (index: number) => LEFT + index * step + step / 2;

const line = hrv.map((value, index) => `${index ? 'L' : 'M'}${n(middle(index))} ${n(hrvY(value))}`).join('');

const label =
  `Sample data for ${nights.length} nights: sleep in hours as bars, between about ${Math.min(...sleep)} and ` +
  `${Math.max(...sleep)} hours, and heart-rate variability in milliseconds as a line, between about ` +
  `${Math.min(...hrv)} and ${Math.max(...hrv)}.`;
---
<svg viewBox="0 0 960 250" role="img" aria-label={label}>
  {
    SLEEP_AXIS.ticks.map((hours) => (
      <Fragment>
        <line class="ax" x1={LEFT} x2={RIGHT} y1={n(sleepY(hours))} y2={n(sleepY(hours))} />
        <text class="num" x={LEFT - 10} y={n(sleepY(hours) + 4)} text-anchor="end">{hours} h</text>
      </Fragment>
    ))
  }
  {HRV_AXIS.ticks.map((ms) => <text class="num" x={RIGHT + 10} y={n(hrvY(ms) + 4)}>{ms} ms</text>)}
  {
    sleep.map((hours, index) => (
      <rect
        class="bar-a"
        x={n(LEFT + index * step + BAR_GAP)}
        y={n(sleepY(hours))}
        width={n(step - 2 * BAR_GAP)}
        height={n(BOTTOM - sleepY(hours))}
        rx="1.5"
      />
    ))
  }
  <path class="ln" d={line} />
  {
    NIGHT_TICKS.map((night) => (
      <text class="num" x={n(middle(night - 1))} y={BOTTOM + 20} text-anchor="middle">Night {night}</text>
    ))
  }
  <text x={LEFT} y="246">Sample data · an exam week on nights {EXAM_WEEK.first} to {EXAM_WEEK.last}: less sleep, lower HRV</text>
</svg>
