---
// Figure 1 of the Career Star case study: of the occupations that declined from 2014 to
// 2024, the share a random pick and Career Star each flagged, with the base rate as a
// dashed line. Goes inside Figure, which styles the classes.
---
<svg
  viewBox="0 0 440 74"
  role="img"
  aria-label="Of the occupations that actually declined from 2014 to 2024, a random pick would flag 33 percent; Career Star flagged 48 percent, 1.45 times as many."
>
  <text class="lb" x="0" y="20">Random pick</text>
  <rect class="bar-a" x="96" y="8" width="150" height="16" rx="2"></rect>
  <text class="num" x="252" y="20">33%</text>
  <text class="lb" x="0" y="44">Career Star</text>
  <rect class="bar-b" x="96" y="32" width="218" height="16" rx="2"></rect>
  <text class="vb num" x="320" y="44">48%, 1.45× as often</text>
  <line class="base" x1="246" x2="246" y1="4" y2="54"></line>
  <line class="ax" x1="96" x2="369" y1="56" y2="56"></line>
  <text class="num" x="96" y="70" text-anchor="middle">0</text>
  <text class="num" x="187" y="70" text-anchor="middle">20%</text>
  <text class="num" x="278" y="70" text-anchor="middle">40%</text>
  <text class="num" x="369" y="70" text-anchor="middle">60%</text>
</svg>
