---
// The closing line of the home page: a hairline, the invitation with the email address,
// then the other ways in. Addresses come from CONTACTS.
import { CONTACTS } from '../lib/contacts';

const RESUME_HREF = '/about#resume';
---
<section class="end" aria-label="Contact">
  <div class="wrap g12">
    <p class="msg">Hiring interns for summer 2027? Email is the fastest way to reach me: <a href={`mailto:${CONTACTS.email}`}>{CONTACTS.email}</a></p>
    <p class="alt">Or read my <a href={RESUME_HREF}>resume</a>, look through my <a href={CONTACTS.github}>GitHub</a>, or find me on <a href={CONTACTS.linkedin}>LinkedIn</a>.</p>
  </div>
</section>

<style>
  .end {
    border-top: 1px solid var(--color-line);
  }

  .end .wrap {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
    align-items: end;
  }

  .msg {
    grid-column: 1 / 9;
    font: var(--type-closing-line);
    font-variant-numeric: lining-nums;
    color: var(--color-ink);
  }

  .msg a {
    white-space: nowrap;
  }

  .alt {
    grid-column: 9 / 13;
    font: var(--type-ui);
    color: var(--color-ink-2);
  }

  @media (max-width: 1060px) {
    .msg {
      grid-column: 1 / -1;
    }

    .alt {
      grid-column: 1 / -1;
      margin-top: var(--space-4);
    }
  }

  @media (max-width: 760px) {
    .msg {
      font: var(--type-closing-line-mobile);
      font-variant-numeric: lining-nums;
    }

    /* 44px touch targets; inline padding moves no line. */
    .msg a {
      white-space: normal;
      overflow-wrap: anywhere;
      padding: 7px 0;
    }

    .alt a {
      padding: 13px 0;
    }
  }
</style>
