---
// Device frame: one phone screenshot inside a dark bezel, cropped from the top to a phone's
// shape. Still: no hover motion.
import type { ImageMetadata } from 'astro';
import FramedImage from './FramedImage.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

// The screen inside the bezel: 38vw less a 5px bezel each side at 760px and below, then
// 13vw less 6px each side, held between 138px and 176px.
const SIZES = '(max-width: 760px) calc(38vw - 10px), (max-width: 1153px) 138px, (max-width: 1446px) calc(13vw - 12px), 176px';
// 1x to 3x of those widths, never above the original.
const widths = [...new Set([140, 180, 280, 360, 530].map((width) => Math.min(width, src.width)))];
---
<figure class="dev">
  <FramedImage src={src} alt={alt} widths={widths} sizes={SIZES} position="top" class="screen" />
</figure>

<style>
  .dev {
    flex: none;
    margin: 0;
    overflow: hidden;
    width: clamp(150px, 13vw, 188px);
    aspect-ratio: 9 / 19.5;
    border: 6px solid var(--color-device-bezel);
    border-radius: 30px;
    background: var(--color-device-bezel);
  }

  /* Both sizes are set, so the frame's shape wins over the image's own. */
  .dev .screen {
    width: 100%;
    height: 100%;
    border-radius: 24px;
  }

  @media (max-width: 760px) {
    .dev {
      width: 38vw;
      border-width: 5px;
    }

    .dev .screen {
      border-radius: 18px;
    }
  }
</style>
