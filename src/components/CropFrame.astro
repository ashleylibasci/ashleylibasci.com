---
// Crop frame: one part of a wide screenshot on a top-rounded plate, inset in a pale frame and
// running off its bottom edge, over its caption (default slot). Sits in an article's text
// column. Still and never a link.
import type { ImageMetadata } from 'astro';
import FramedImage from './FramedImage.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;

// The image is drawn wider than the plate (see `.shot`). The plate is the frame less its
// insets; the frame fills the text column (the full row on phones, 7 of 12 columns inside
// the tablet and then the desktop gutters) up to 620px.
const ZOOM = 1.171;
const SIZES = [
  `(max-width: 760px) calc((100vw - 72px) * ${ZOOM})`,
  `(max-width: 1060px) calc((58.33vw - 103px) * ${ZOOM})`,
  `(max-width: 1208px) calc((58.33vw - 141px) * ${ZOOM})`,
  `${Math.round(564 * ZOOM)}px`,
].join(', ');
// 1x to 3x of those widths, never above the original.
const widths = [...new Set([360, 660, 1000, 1320, 1980].map((width) => Math.min(width, src.width)))];
---
<figure class="crop">
  <div class="frame">
    <div class="plate"><FramedImage src={src} alt={alt} widths={widths} sizes={SIZES} class="shot" /></div>
  </div>
  <figcaption class="cap"><slot /></figcaption>
</figure>

<style>
  .crop {
    margin-top: var(--space-5);
    max-width: 620px;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9.2;
    overflow: hidden;
    background: var(--color-field);
    border-radius: var(--radius-lg);
  }

  .plate {
    position: absolute;
    inset: 28px 28px -1px;
    overflow: hidden;
    background: var(--color-photo-placeholder);
    border: 1px solid var(--color-line);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
  }

  /* The crop: a little wider than the plate and moved up, past the screenshot's top bar. */
  .plate .shot {
    position: absolute;
    top: 0;
    left: -8.13%;
    width: 117.1%;
    max-width: none;
    margin-top: -13.66%;
    border-radius: 0;
  }

  .cap {
    margin-top: var(--space-2);
    font: var(--type-meta);
    color: var(--color-ink-3);
  }

  @media (max-width: 760px) {
    .plate {
      inset: 16px 16px -1px;
    }
  }
</style>
