---
// Page head for inner pages: breadcrumb, title, standfirst and an optional row of links.
// The standfirst is the `standfirst` text or, for Markdown HTML, the `standfirst` slot.
// The title is the skip-link and page-load focus target. The About head passes a framed
// photo in the `photo` slot: it sits left of the text, and above it on phones.

interface Props {
  title: string;
  standfirst?: string;
  /** Breadcrumb steps before this page, first to last. */
  crumbs?: readonly { label: string; href: string }[];
  /** The breadcrumb's last step, when it is not the title. */
  current?: string;
}

const { title, standfirst, crumbs = [], current = title } = Astro.props;
// Rendered first so a links slot that comes out empty adds no row and no gap.
const links = Astro.slots.has('links') ? (await Astro.slots.render('links')).trim() : '';
const photo = Astro.slots.has('photo') ? (await Astro.slots.render('photo')).trim() : '';
---
<div class:list={['wrap', 'phead', { 'with-photo': photo }]}>
  {photo && <Fragment set:html={photo} />}
  <div class="text">
    <nav class="crumb" aria-label="Breadcrumb">
      {
        crumbs.map((step) => (
          <Fragment>
            <a href={step.href}>{step.label}</a>
            {' / '}
          </Fragment>
        ))
      }<span>{current}</span>
    </nav>
    <h1 id="page-heading" tabindex="-1">{title}</h1>
    <p class="standfirst"><slot name="standfirst">{standfirst}</slot></p>
    {links && <p class="links" set:html={links} />}
  </div>
</div>

<style>
  .phead {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .with-photo {
    display: flex;
    align-items: center;
    gap: 44px;
  }

  .with-photo .text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .crumb {
    font: var(--type-label);
    color: var(--color-ink-3);
  }

  .crumb a {
    color: var(--color-ink-3);
  }

  .crumb a:hover {
    color: var(--color-ink);
  }

  h1 {
    margin-top: var(--space-3);
    font: var(--type-page-title);
  }

  .standfirst {
    margin-top: var(--space-4);
    font: var(--type-standfirst);
    max-width: 38em;
    color: var(--color-ink-2);
  }

  .links {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font: var(--type-ui);
  }

  @media (max-width: 760px) {
    .with-photo {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
  }
</style>
