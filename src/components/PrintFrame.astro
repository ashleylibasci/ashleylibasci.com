---
// Print frame: a nearly white print border with a fine hairline, in both themes.
// Holds a framed image or any other content. Whoever places it sets its size.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'figure'> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---
<figure class:list={['print-frame', className]} {...rest}>
  <slot />
</figure>

<style>
  .print-frame {
    display: block;
    background: var(--color-print);
    padding: 10px;
    border: 1px solid var(--color-print-line);
    border-radius: var(--radius-print);
    transition:
      translate var(--t) var(--ease),
      border-color var(--t) ease-out;
  }

  /* On hover the print lifts 2px and its hairline darkens. */
  .print-frame:hover {
    translate: 0 -2px;
    border-color: var(--color-print-line-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .print-frame:hover {
      translate: none;
    }
  }

  @media (max-width: 760px) {
    .print-frame {
      padding: 7px;
    }
  }
</style>
