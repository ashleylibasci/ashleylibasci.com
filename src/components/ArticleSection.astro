---
// Article section of an inner page: the heading in columns 1 to 3, the text in columns 4 to 10
// (default slot) and, when given, a wide block in columns 4 to 12 under it (`wide` slot).
// Goes inside `.wrap.art`, which base.css lays out. The text is Markdown HTML and carries no
// scope attribute, so the styles for what it holds (subheads, the Feature list `dl.feat`,
// the Facts list `dl.facts`, the Formula block `.math`, the Highlight `mark`, a plain list,
// the Code block `.code` and its caption `.cap`) are global, under `.art`.
interface Props {
  id: string;
  /** The heading's inner HTML, as the Markdown processor gives it. */
  heading: string;
}

const { id, heading } = Astro.props;
// Rendered first so a wide slot that comes out empty adds no block and no gap.
const wide = Astro.slots.has('wide') ? (await Astro.slots.render('wide')).trim() : '';
---
<section class="g12">
  <h2 id={id} set:html={heading} />
  <div class="col"><slot /></div>
  {wide && <div class="wide" set:html={wide} />}
</section>

<style>
  .wide {
    grid-column: 4 / 13;
    margin-top: var(--space-6);
    min-width: 0;
  }

  @media (max-width: 760px) {
    .wide {
      margin-top: var(--space-5);
    }
  }
</style>

<style is:global>
  .art .col h3 {
    font: var(--type-entry-title);
    margin-top: var(--space-5);
  }

  .art .col h3:first-child {
    margin-top: 0;
  }

  .art .col h3 + p {
    margin-top: var(--space-2);
    max-width: 40em;
  }

  .art .col .fig + p {
    margin-top: var(--space-5);
  }

  /* Plain list: each item may open with a bold lead-in. */
  .art .col > ul {
    padding-left: 20px;
    max-width: 42em;
  }

  .art .col > ul > li + li {
    margin-top: var(--space-3);
  }

  .art .col > ul > li > strong:first-child {
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Formula block: one formula a line, variable names in italic, an optional small note. */
  .art .math {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    font: var(--type-formula);
    /* The shorthand resets figures. */
    font-variant-numeric: tabular-nums lining-nums;
    max-width: 32em;
  }

  .art .math i {
    font-style: italic;
  }

  .art .math .n {
    margin-left: var(--space-2);
    font: var(--type-meta);
    color: var(--color-ink-3);
  }

  /* Code block: a file-name bar over monospace code. Long lines scroll inside the block. */
  .art .code {
    margin-top: var(--space-4);
    max-width: 42em;
    background: var(--color-code);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    /* The scroll area's corners follow the block's. */
    overflow: hidden;
  }

  .art .code .fn {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    font: var(--type-caption);
    color: var(--color-ink-3);
  }

  .art .code pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    font: var(--type-code);
    color: var(--color-ink);
  }

  .art .code pre:focus-visible {
    outline-offset: -3px;
  }

  .art .code .c {
    color: var(--color-ink-3);
  }

  .art .code .k {
    color: var(--color-link);
  }

  /* The line under a Code block. */
  .art .col > .cap {
    margin-top: var(--space-2);
    font: var(--type-meta);
    color: var(--color-ink-3);
  }

  /* Highlight: the one key number of a page. It never wraps. */
  .art mark {
    white-space: nowrap;
    background: var(--color-mark);
    color: var(--color-mark-ink);
    padding: 0 4px;
    border-radius: var(--radius-print);
  }

  /* Feature list: a term in the heading face, its description beside it. */
  .art dl.feat {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: var(--space-3) var(--space-5);
    max-width: 48em;
  }

  .art dl.feat dt {
    font: var(--type-feature-term);
    font-variant-numeric: lining-nums;
  }

  .art dl.feat dd {
    margin: 0;
    color: var(--color-ink-2);
  }

  /* Facts list: a quiet term, its value beside it. */
  .art dl.facts {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    font: var(--type-ui);
    max-width: 46em;
  }

  .art dl.facts dt {
    color: var(--color-ink-3);
  }

  .art dl.facts dd {
    margin: 0;
  }

  @media (max-width: 760px) {
    .art dl.feat,
    .art dl.facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .art dl.feat dd,
    .art dl.facts dd {
      margin-bottom: var(--space-3);
    }
  }
</style>
